# Neon Postgres. Never commit the real value; .env is gitignored.
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/thescore?sslmode=require

# Object storage for finished tracks and cover art.
# Works with AWS S3 or any S3-compatible endpoint.
S3_BUCKET=amzn-s3-studio
S3_REGION=us-east-1
# Leave blank for AWS S3; set for an S3-compatible provider.
S3_ENDPOINT=
# Public base URL for stored objects, if serving directly rather than proxying.
S3_PUBLIC_BASE_URL=

# How long an attendee's track is kept before it is purged, in days.
RETENTION_DAYS=365

# S3 authenticates with SigV4 request signing, so the SDK needs these in the
# environment. Use an IAM user scoped to PutObject/GetObject/DeleteObject on
# this bucket only — never a broad key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# kie.ai API key, sent as `Authorization: Bearer`. Required on any normal host.
# Without it, generation requests go out unauthenticated and the provider
# answers 401 — which looks like every track failing for no reason.
KIE_API_KEY=
